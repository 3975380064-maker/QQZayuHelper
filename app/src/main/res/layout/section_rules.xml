<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Zayu.Card">

    <LinearLayout style="@style/Widget.Zayu.CardContent">

        <TextView
            style="@style/Widget.Zayu.SectionTitle"
            android:text="@string/section_custom_rules"
            app:drawableStartCompat="@drawable/ic_list"
            app:drawableTint="?attr/colorPrimary" />

        <TextView
            style="@style/Widget.Zayu.SectionSummary"
            android:text="@string/section_custom_rules_summary" />

        <!-- 规则行由代码动态填充 item_rule.xml -->
        <LinearLayout
            android:id="@+id/rulesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvRulesEmpty"
            style="@style/Widget.Zayu.SectionSummary"
            android:layout_marginTop="4dp"
            android:text="@string/rules_empty" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddRule"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/action_add_rule"
            app:icon="@drawable/ic_add" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>