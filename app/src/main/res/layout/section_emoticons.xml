<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Zayu.Card">

    <LinearLayout style="@style/Widget.Zayu.CardContent">

        <TextView
            style="@style/Widget.Zayu.SectionTitle"
            android:text="@string/section_custom_emoticons"
            app:drawableStartCompat="@drawable/ic_emoticon"
            app:drawableTint="?attr/colorPrimary" />

        <TextView
            style="@style/Widget.Zayu.SectionSummary"
            android:text="@string/helper_emoticons" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emoticonsRow"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/hint_one_per_line">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustomEmoticons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:minLines="4" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>