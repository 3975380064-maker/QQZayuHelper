<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      本文件只放"结构"样式（间距 / 圆角 / 字号层级），不放任何颜色。
      颜色一律通过 Material3 主题属性（?attr/color*、?attr/textAppearance*）取，
      这样深色模式不需要在布局里做任何分支。
    -->

    <style name="Widget.Zayu.Card" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- 卡片内统一的 16dp 内边距容器（parent="" 表示不继承，否则会按点号去找 Widget.Zayu） -->
    <style name="Widget.Zayu.CardContent" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- 分组标题：左侧一个跟随主题着色的图标 -->
    <style name="Widget.Zayu.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.Zayu.SectionSummary" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Zayu.Switch" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- 卡片之间 / 分组内部的分隔线，用主题的 outlineVariant，深浅色都刚好 -->
    <style name="Widget.Zayu.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

</resources>