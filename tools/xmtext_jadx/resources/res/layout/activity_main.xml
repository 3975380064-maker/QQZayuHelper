<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:id="@+id/statusText"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_unknown"/>
        <Button
            android:id="@+id/openAccessibilityBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_accessibility_settings"/>
        <View
            android:background="#cccccc"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginVertical="16dp"/>
        <TextView
            android:textStyle="bold"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keep_alive_section_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#666666"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keep_alive_section_hint"/>
        <Button
            android:textColor="@color/teal_700"
            android:id="@+id/batteryWhitelistBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/keep_alive_battery_btn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        <Button
            android:textColor="@color/teal_700"
            android:id="@+id/autostartBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/keep_alive_autostart_btn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        <Button
            android:textColor="@color/teal_700"
            android:id="@+id/vivoPowerBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/keep_alive_vivo_power_btn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        <View
            android:background="#cccccc"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginVertical="16dp"/>
        <TextView
            android:textStyle="bold"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mode_section_title"/>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/modeGroup"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/modeRealtime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/mode_realtime"
                android:layout_weight="1"/>
            <RadioButton
                android:id="@+id/modePunct"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/mode_punct"
                android:layout_weight="1"/>
        </RadioGroup>
        <TextView
            android:textSize="12sp"
            android:textColor="#666666"
            android:id="@+id/modeDescText"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textStyle="bold"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/features_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#666666"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/features_hint"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/featuresContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Button
            android:textColor="@color/teal_700"
            android:id="@+id/addFeatureBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="@string/add_feature"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        <View
            android:background="#cccccc"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginVertical="8dp"/>
        <TextView
            android:textStyle="bold"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scope_section_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#666666"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scope_hint"/>
        <EditText
            android:textSize="14sp"
            android:gravity="start|top"
            android:id="@+id/scopeInput"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="@string/scope_hint_example"
            android:inputType="textNoSuggestions"
            android:fontFamily="monospace"/>
        <Button
            android:textColor="@color/teal_700"
            android:id="@+id/pickAppBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/scope_pick_app_btn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        <View
            android:background="#cccccc"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginVertical="8dp"/>
        <TextView
            android:textStyle="bold"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rules_section_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#666666"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rules_hint"/>
        <EditText
            android:textSize="14sp"
            android:gravity="start|top"
            android:id="@+id/rulesInput"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:hint="@string/rules_hint_example"
            android:inputType="textNoSuggestions"
            android:fontFamily="monospace"/>
    </LinearLayout>
</ScrollView>
